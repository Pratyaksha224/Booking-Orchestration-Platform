{
  "openapi": "3.0.0",
  "info": {
    "title": "Booking Orchestration API Gateway",
    "version": "1.0.0",
    "description": "API Gateway for the Distributed Booking Orchestration Platform"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local API Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/ping": {
      "get": {
        "summary": "Health Check",
        "description": "Returns 200 OK if API Gateway is running.",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "role": { "type": "string", "enum": ["GUEST", "HOST", "ADMIN"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login and receive JWT",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Returns JWT token" }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Returns user profile details" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/properties": {
      "get": {
        "summary": "Get all active properties",
        "tags": ["Properties"],
        "responses": {
          "200": { "description": "List of properties" }
        }
      },
      "post": {
        "summary": "Create a new property",
        "tags": ["Properties"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "addressId": { "type": "number" },
                  "pricePerNight": { "type": "number" },
                  "maxGuests": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Property created" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden (Requires HOST or ADMIN role)" }
        }
      }
    },
    "/properties/{id}": {
      "get": {
        "summary": "Get specific property details",
        "tags": ["Properties"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Property details" }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Create a preliminary booking",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "propertyId": { "type": "number" },
                  "totalGuests": { "type": "number" },
                  "bookingAmount": { "type": "number" },
                  "checkInDate": { "type": "string", "format": "date-time" },
                  "checkOutDate": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Booking created, returns idempotencyKey" }
        }
      }
    },
    "/bookings/confirm/{idempotencyKey}": {
      "post": {
        "summary": "Confirm a preliminary booking",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "idempotencyKey", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Booking confirmed successfully" }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "summary": "Get specific booking details",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Booking details" }
        }
      }
    },
    "/bookings/user/{userId}": {
      "get": {
        "summary": "Get all bookings for a user",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of bookings" }
        }
      }
    },
    "/bookings/cancel/{id}": {
      "post": {
        "summary": "Cancel a booking",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Booking cancelled" }
        }
      }
    }
  }
}
